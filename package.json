{
  "name": "ui-library",
  "version": "0.1.0",
  "private": true,
  "description": "Biblioteca web pública de componentes de interface — monorepo pnpm (MVP1: fundação)",
  "license": "ISC",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "pnpm --filter @uilib/api dev",
    "build": "pnpm -r --if-present run build",
    "lint": "pnpm -r --if-present run lint",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0"
  }
}
