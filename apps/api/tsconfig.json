{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "types": ["node"]
  },
  // Inclui "prisma", "tests" e os configs de teste na raiz para que também
  // sejam verificados pelo `typecheck`, embora não façam parte do build de
  // dist (ver tsconfig.build.json).
  "include": ["src", "prisma", "tests", "vitest.config.ts", "vitest.setup.ts"]
}
